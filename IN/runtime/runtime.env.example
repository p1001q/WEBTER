# SSM SecureString의 내용. 각 비밀번호는 서로 다르게 openssl rand -hex 32로 생성한다.
# 이 예시 파일 자체를 운영 값으로 업로드하지 않는다.
PG_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_CHARACTERS
PG_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS

# 아래는 Spring Boot 앱에 전달된다.
# 값은 따옴표 없이 한 줄로 작성한다. 다중 행 값은 지원하지 않는다.
AUTH_FRONTEND_ORIGIN=https://app.webter.store
AUTH_BACKEND_ORIGIN=https://api.webter.store
CORS_ALLOWED_ORIGINS=https://app.webter.store
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# DB·Redis 비밀번호와 별도로 openssl rand -hex 32로 생성한다.
SERVICE_EVENT_IP_HMAC_KEY=REPLACE_WITH_EVENT_IP_HMAC_KEY

# 이미지 저장소. 값은 Terraform output(image_bucket, image_public_base_url)과 IAM 접근 키(IN/README.md 절차)에서 얻는다.
IMAGE_BUCKET=REPLACE_WITH_IMAGE_BUCKET
IMAGE_REGION=ap-northeast-2
IMAGE_PUBLIC_BASE_URL=REPLACE_WITH_CLOUDFRONT_URL
IMAGE_S3_ACCESS_KEY=REPLACE_WITH_APP_IMAGES_ACCESS_KEY_ID
IMAGE_S3_SECRET_KEY=REPLACE_WITH_APP_IMAGES_SECRET_ACCESS_KEY
