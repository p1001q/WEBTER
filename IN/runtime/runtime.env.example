# AWS 서울 리전 Parameter Store의 /webter/prod/runtime-env (SecureString)용 예시다.
# 기존 파라미터를 수정할 때는 아래 네 값의 기존 내용을 보존한다.
# 처음 등록할 때는 각 키에 openssl rand -hex 32를 실행해 서로 다른 값을 넣는다.
PG_ADMIN_PASSWORD=
PG_APP_PASSWORD=
REDIS_PASSWORD=
SERVICE_EVENT_IP_HMAC_KEY=

# 운영 프론트엔드, 백엔드, CORS 주소. 모든 값은 따옴표 없이 한 줄로 넣는다.
AUTH_FRONTEND_ORIGIN=https://app.webter.store
AUTH_BACKEND_ORIGIN=https://api.webter.store
CORS_ALLOWED_ORIGINS=https://app.webter.store

# 운영 Google OAuth 클라이언트에서 발급한 ID와 시크릿을 입력한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Terraform으로 생성한 운영 이미지 버킷과 CloudFront 주소
IMAGE_BUCKET=webter-prod-526426842030-ap-northeast-2-images
IMAGE_REGION=ap-northeast-2
IMAGE_PUBLIC_BASE_URL=https://d3ajke6npyg3fa.cloudfront.net

# IAM 사용자 webter-prod-app-images에서 발급한 액세스 키 ID와 보안 액세스 키를 입력한다.
IMAGE_S3_ACCESS_KEY=
IMAGE_S3_SECRET_KEY=

# 세션 만료와 운영 HTTPS 쿠키 설정
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=true
