# FE 디렉터리에서 cp .env.example .env.local로 복사한다.
# NEXT_PUBLIC_ 변수는 브라우저에 공개된다. Google 로그인 시크릿은 백엔드에서 설정한다.

# 로컬 백엔드 API 주소. 백엔드 포트가 다르면 맞추고, 목업 모드로 실행하려면 이 줄을 주석 처리한다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 서버 렌더링 전용 주소. 브라우저용 API 주소와 다를 때만 활성화한다. 루트 Compose는 자동 설정한다.
# API_INTERNAL_BASE_URL=http://localhost:8080

# 로컬에서 공유 미리보기 주소를 확인할 때 활성화한다.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Production 환경변수에는 아래 값을 사용한다.
# NEXT_PUBLIC_API_BASE_URL=https://api.webter.store
# API_INTERNAL_BASE_URL=https://api.webter.store
# NEXT_PUBLIC_SITE_URL=https://app.webter.store
