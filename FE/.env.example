# 로컬 값은 .env.local에 둔다(Git 제외). 비밀키를 NEXT_PUBLIC_ 접두사가 붙은 변수에 넣지 않는다.
# 구글 로그인의 클라이언트 ID·시크릿은 BE에서만 사용하므로 FE에는 두지 않는다.

# 백엔드 API 주소(브라우저에서 호출하는 주소)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 서버 렌더링이 백엔드에 접속하는 주소. 브라우저가 쓰는 주소(위 값)와 다를 때만 지정한다. 통합 compose는 자동으로 넣는다.
# API_INTERNAL_BASE_URL=http://localhost:8080
