# FE 디렉터리에서 cp .env.example .env.local로 복사한다.
# NEXT_PUBLIC_ 변수는 브라우저에 공개된다. Google 로그인 시크릿은 백엔드에서 설정한다.

# 로컬 API 주소. 백엔드 포트가 다르면 두 주소를 맞추고, 목업 모드에서는 두 값을 비운다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_INTERNAL_BASE_URL=http://localhost:8080

# 공유 미리보기에 사용할 프론트엔드 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Production에서는 두 API 주소를 https://api.webter.store로, 사이트 주소를 https://app.webter.store로 바꾼다.
