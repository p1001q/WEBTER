# 복사해서 루트 .env로 쓴다(cp .env.example .env). 로컬 통합 실행(docker compose up --build)용이며 Git에서 제외된다.
# 아래 값은 기본값이라 그대로 두면 값을 지정하지 않은 것과 같다. 구글 클라이언트 값만 채우면 된다.

# 호스트에서 접속할 포트(이 PC처럼 8080이 이미 쓰이면 바꾼다)
FE_PORT=3000
BE_PORT=8080

# 구글 웹 OAuth 클라이언트. 비밀값이므로 .env 에만 적는다. 구글 콘솔 콜백: http://localhost:{BE_PORT}/login/oauth2/code/google
# 두 값이 모두 없으면 구글 로그인은 시작되지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
