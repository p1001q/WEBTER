# 루트에서 cp .env.example .env로 복사한 뒤 docker compose up --build로 로컬 통합 실행한다.
# 운영 백엔드 SSM 설정은 IN/runtime/runtime.env.example을 참고한다.

# 호스트 접속 포트. 다른 서비스가 사용 중이면 해당 값만 바꾼다.
FE_PORT=3000
BE_PORT=8080
IMAGE_PORT=9090

# 로컬 구글 로그인을 테스트할 때만 Google Cloud에서 발급한 ID와 시크릿을 복사한 .env에 넣는다.
# 승인된 리디렉션 URI는 http://localhost:8080/login/oauth2/code/google이다. BE_PORT를 바꾸면 URI의 포트도 맞춘다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
