# BE 디렉터리에서 cp .env.example .env로 복사한 뒤 docker compose up -d와 ./gradlew bootRun으로 실행한다.
# bootRun은 기본으로 local 프로파일을 사용한다. Redis 세션을 쓰려면 SPRING_PROFILES_ACTIVE=local,redis-session ./gradlew bootRun으로 실행한다.
# 운영 백엔드 SSM 설정은 IN/runtime/runtime.env.example을 참고한다.

# 백엔드 수신 포트
PORT=8080

# BE/compose.yml의 PostgreSQL 접속 정보. 비밀번호는 공개된 로컬 개발용 고정값이다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webter
DB_USER=webter
DB_PASSWORD=webter

# Redis 세션을 테스트할 때 사용하는 로컬 Redis. BE/compose.yml은 비밀번호를 설정하지 않는다.
REDIS_HOST=localhost
REDIS_PORT=6379

# 로컬 S3Mock 설정. IMAGE_PORT를 바꾸면 아래 endpoint와 이미지 주소의 포트도 맞춘다.
# 접근 키 두 값은 S3Mock용 공개 테스트 값이다.
IMAGE_PORT=9090
IMAGE_BUCKET=webter-images
IMAGE_REGION=ap-northeast-2
IMAGE_S3_ENDPOINT=http://localhost:9090
IMAGE_S3_PUBLIC_ENDPOINT=http://localhost:9090
IMAGE_PUBLIC_BASE_URL=http://localhost:9090/webter-images
IMAGE_S3_ACCESS_KEY=local-access-key
IMAGE_S3_SECRET_KEY=local-secret-key

# 프론트엔드 포트를 바꾸면 CORS_ALLOWED_ORIGINS와 AUTH_FRONTEND_ORIGIN을 함께 맞춘다.
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_FRONTEND_ORIGIN=http://localhost:3000
AUTH_BACKEND_ORIGIN=http://localhost:8080

# 로컬 구글 로그인을 테스트할 때만 발급한 ID와 시크릿을 복사한 .env에 넣는다.
# Google Cloud의 승인된 리디렉션 URI는 AUTH_BACKEND_ORIGIN 뒤에 /login/oauth2/code/google을 붙인 값이다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 세션 비활동 만료 시간과 로컬 HTTP용 쿠키 설정
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false

# 로컬에서는 방문자 IP 판정에 앱의 개발용 HMAC 키를 사용한다. 운영 키는 SSM에서 설정한다.
