# 복사해서 BE/.env로 쓴다(cp .env.example .env). BE/.env는 로컬 실행(local 프로파일)에서만 읽히고 Git에서 제외된다.
# 아래 값은 로컬 기본값이라 그대로 두면 값을 지정하지 않은 것과 같다. 구글 클라이언트 값만 채우면 된다.
# 운영에서는 이 파일을 쓰지 않고 같은 이름의 환경변수로 주입한다. 비밀값을 이 파일이나 코드에 적지 않는다.

# 실행 프로파일: 로컬은 local(./gradlew bootRun 기본값), 운영은 지정하지 않는다
# Redis 세션으로 확인하려면 local,redis-session
SPRING_PROFILES_ACTIVE=local

# 수신 포트(기본 8080)
PORT=8080

# PostgreSQL 접속 정보(BE/compose.yml의 로컬 DB와 같은 값)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webter
DB_USER=webter
DB_PASSWORD=webter

# Redis 접속 정보(로그인 세션 저장소). redis-session 프로파일과 운영에서 쓰고, 메모리 세션(local 기본)에서는 쓰지 않는다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 이미지 저장소(S3). 로컬은 BE/compose.yml의 images(S3 호환)를 쓴다. 운영은 AWS S3 값으로 바꾸고 endpoint·키는 비운다.
# IMAGE_BUCKET이 비어 있으면 이미지 업로드는 꺼진다(업로드 API가 503).
IMAGE_BUCKET=webter-images
IMAGE_REGION=ap-northeast-2
IMAGE_S3_ENDPOINT=http://localhost:9090
IMAGE_S3_PUBLIC_ENDPOINT=http://localhost:9090
IMAGE_PUBLIC_BASE_URL=http://localhost:9090/webter-images
IMAGE_S3_ACCESS_KEY=local-access-key
IMAGE_S3_SECRET_KEY=local-secret-key

# API 호출을 허용할 프론트엔드 도메인(쉼표로 구분). 비어 있으면 다른 도메인의 호출을 모두 막는다.
# 예: https://webter.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google 웹 OAuth 클라이언트(Google Cloud Console에서 발급). 비밀값이므로 .env에만 적고 커밋하지 않는다.
# 두 값이 모두 없으면 구글 로그인은 시작되지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인 후 돌아갈 프론트엔드 주소와 이 서버의 외부 주소(구글 리디렉션 URI의 기준)
# 구글 콘솔에 등록할 리디렉션 URI: {AUTH_BACKEND_ORIGIN}/login/oauth2/code/google
AUTH_FRONTEND_ORIGIN=http://localhost:3000
AUTH_BACKEND_ORIGIN=http://localhost:8080

# 세션 비활동 만료 시간(메모리·Redis 세션 공통)과 쿠키 Secure 속성(HTTPS에서는 true, 로컬 HTTP는 false)
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
