# 로컬 실행은 값을 지정하지 않아도 기본값(localhost, webter/webter)으로 동작한다.
# 운영에서는 아래 변수를 환경변수로 주입한다. 비밀값을 이 파일이나 코드에 적지 않는다.

# 실행 프로파일: 로컬은 local(./gradlew bootRun 기본값), 운영은 지정하지 않는다
# SPRING_PROFILES_ACTIVE=local

# 수신 포트(기본 8080)
# PORT=8080

# PostgreSQL 접속 정보
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=webter
# DB_USER=
# DB_PASSWORD=

# API 호출을 허용할 프론트엔드 도메인(쉼표로 구분). 비어 있으면 다른 도메인의 호출을 모두 막는다.
# 예: https://webter.vercel.app
# CORS_ALLOWED_ORIGINS=
